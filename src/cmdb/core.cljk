(ns cmdb.core
  "cmdb guest（aiueos/cmdb_core.cljk）と同名・同結果の adapter 関数。
  文字列→コードの橋渡しはここだけが行う。guest は i64 のみ。")

(def criticality-codes {"critical" 3 "high" 2 "medium" 1 "low" 0})
(def data-class-codes {"sensitive" 2 "personal" 1 "public" 0 "internal" 0})

(defn criticality-points [level]
  (if (< level 0)
    -1
    (if (= level 3)
      40
      (if (= level 2)
        30
        (if (= level 1)
          20
          (if (= level 0)
            10
            -1))))))

(defn data-class-points [class]
  (if (< class 0)
    -1
    (if (= class 2)
      20
      (if (= class 1)
        10
        0))))

(defn priority-score [criticality data-class]
  (let [c (criticality-points criticality)
        d (data-class-points data-class)]
    (if (or (= c -1) (= d -1))
      -1
      (+ c d))))

(defn- changed-at [before after n i]
  (if (< i n)
    (if (= (nth before i) (nth after i))
      (recur before after n (inc i))
      1)
    0))

(defn version-changed? [before after]
  (let [n (count before)]
    (if (= n (count after))
      (changed-at before after n 0)
      1)))

(defn priority-score-of [criticality data-class]
  (priority-score (get criticality-codes criticality -1)
                 (get data-class-codes data-class -1)))

(defn str-codes [s]
  (mapv #(.charCodeAt s %) (range (count s))))
